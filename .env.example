# Variáveis SERVER-SIDE do proxy /api/lead.ts — configurar na Vercel
# (Environment Variables do projeto). NUNCA usar prefixo VITE_ aqui:
# tudo com VITE_ vaza para o bundle do browser.

# Segredo enviado no header x-nexo-secret ao repassar o lead ao Concierge.
CONCIERGE_SECRET=

# Override opcional do webhook por ambiente (ex.: preview apontando para
# o Concierge local). Se vazio, o proxy usa o conciergeWebhook do JSON do tenant.
CONCIERGE_WEBHOOK_URL=
